__pycache__/
*.pyc
*.pyo
.pytest_cache/
.ruff_cache/
.venv/
venv/
*.egg-info/
dist/
build/

# Local data
.env
*.db
*.db-journal
.cost_ledger.json
reports/
predictions/

# OASIS runtime logs (the framework hardcodes ./log as its log dir
# in env.py and platform.py, so it reappears on every sim run).
log/

# OS / editor
.DS_Store
.idea/
.vscode/
*.swp

# Tool working dirs (browser test artifacts, etc.)
.playwright-mcp/
.gstack/
tmp/

# Stray dev screenshots at repo root — /browse + manual captures keep
# producing these. docs/ and frontend/ screenshots stay tracked; loose
# PNGs in the project root are always dev junk.
/*.png

# Browser accessibility snapshots dumped at repo root by /browse and /qa
# (iter2-home-snap.yml, setup-bottom-snap.yml, ...). Real config lives in
# subdirectories, so a root-level glob is safe.
/*.yml

# Claude Code local session state (permissions, task locks).
.claude/

# Extra local venv + ad-hoc analysis artifacts
/.venv312/
/analysis/backtest_monthly_v2_full.json

# Internal working notes and handoff material — kept locally, not published.
/AUTO_REVIEW.md
/TODO.md
/HANDOFF_FRONTEND.md
/REVIEW_STATE.json
/review-loop/
/docs/handoff-baselines/
