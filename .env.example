# yourapi.cn OpenAI-compatible aggregator
OPENAI_API_KEY=sk-replace-me-with-your-yourapi-key
OPENAI_BASE_URL=https://yourapi.cn/v1

# Default model used by personas that don't specify their own
SSFISH_DEFAULT_MODEL=gpt-4o-mini

# Simulation knobs
SSFISH_N_ROUNDS=5
SSFISH_TEMPERATURE=0.0
SSFISH_SEED=42

# Cost guard — refuse new calls if accumulated session cost exceeds this (USD)
SSFISH_BUDGET_USD=5.0

# Local files
SSFISH_COST_LEDGER=./.cost_ledger.json
SSFISH_SCORECARD_DB=./scorecard.db

# Flask basic auth password (single-user mode)
SSFISH_PASSWORD=change-me
